# Данные пользователей: поездки, места и загруженные фотографии — не коммитить
data/

# Секреты для docker-compose.prod.yml (GIGACHAT_AUTH_KEY, ADMIN_INTERNAL_KEY) —
# подставляются через ${VAR:-}, живут только на сервере, права 600
.env

# Временные базы сквозного теста (test/e2e.mjs поднимает сервисы на своей копии)
test/.work/

# Локальный запуск: свои базы auth и сервиса (node dev.mjs)
.dev/

# Артефакты ОС/редакторов
*.log
.DS_Store
Thumbs.db

# Фотографии чеков для ручной проверки распознавания — в репозиторий не нужны
test/fixtures/
assets/__fx/
